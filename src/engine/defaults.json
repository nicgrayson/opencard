{
  "name": "Scorecard",
  "version": "1.0.0",
  "description": "",
  "author": "",
  "theme": {
    "colors": {
      "primary": "#3a9bd5",
      "primaryLight": "#b8ddf0",
      "primaryMuted": "#d4ecf6",
      "primaryFaint": "#eaf5fb",
      "ink": "#2c3e50",
      "background": "#fdfdfd",
      "pageBackground": "#e8e0d6",
      "border": "#a5d4e8",
      "borderLight": "#a5d4e8",
      "diamondFill": "#e2f1f8",
      "diamondStroke": "#cde6f2"
    },
    "fonts": {
      "display": "Barlow Condensed",
      "body": "Barlow"
    },
    "sizing": {
      "inningCellWidth": 64,
      "rowHeight": 66,
      "playerColWidth": 110,
      "posColWidth": 28,
      "batColWidth": 18,
      "statColWidth": 24
    }
  },
  "page": {
    "size": "LETTER",
    "orientation": "landscape",
    "margins": {
      "top": 24,
      "right": 24,
      "bottom": 24,
      "left": 24
    }
  },
  "header": {
    "show": true,
    "showOnSecondPage": true,
    "logo": {
      "show": false,
      "size": 34
    },
    "fields": [
      { "key": "date", "label": "Date", "width": "15%" },
      { "key": "start", "label": "Start", "width": "8%" },
      { "key": "end", "label": "End", "width": "8%" },
      { "key": "awayTeam", "label": "Away", "width": "20%" },
      { "key": "homeTeam", "label": "Home", "width": "20%" },
      { "key": "venue", "label": "Venue", "width": "25%" },
      { "key": "weather", "label": "Weather", "width": "15%" }
    ]
  },
  "grid": {
    "rows": 10,
    "innings": 12,
    "showInningLabels": true,
    "substitutionLines": 0,
    "lobRow": {
      "show": true,
      "label": "LOB"
    },
    "statColumns": [
      {
        "key": "AB",
        "label": "AB"
      },
      {
        "key": "R",
        "label": "R"
      },
      {
        "key": "H",
        "label": "H"
      },
      {
        "key": "RBI",
        "label": "RBI"
      }
    ]
  },
  "cell": {
    "outcomes": {
      "show": true,
      "position": "top",
      "items": [
        "1B",
        "2B",
        "3B",
        "HR",
        "BB"
      ]
    },
    "diamond": {
      "show": true,
      "style": "filled",
      "maxSize": 42
    },
    "count": {
      "show": true,
      "position": "bottom-right",
      "balls": 3,
      "strikes": 2,
      "layout": "vertical"
    }
  },
  "pitchers": {
    "rows": 5,
    "stats": [
      {
        "key": "R/L",
        "label": "R/L"
      },
      {
        "key": "IP",
        "label": "IP"
      },
      {
        "key": "H",
        "label": "H"
      },
      {
        "key": "R",
        "label": "R"
      },
      {
        "key": "ER",
        "label": "ER"
      },
      {
        "key": "BB",
        "label": "BB"
      },
      {
        "key": "K",
        "label": "K"
      }
    ]
  },
  "scoreboard": {
    "show": true,
    "totals": [
      "R",
      "H",
      "E"
    ]
  },
  "notes": {
    "show": true,
    "lines": 5
  },
  "fielding": {
    "show": false,
    "size": 360
  },
  "print": {
    "fitToPage": true
  },
  "pages": "both",
  "sections": {
    "away": {
      "label": "Top",
      "footer": [
        "pitchers",
        "fielding",
        "notes"
      ]
    },
    "home": {
      "label": "Bottom",
      "footer": [
        "pitchers",
        "fielding",
        "scoreboard",
        "notes"
      ]
    }
  }
}